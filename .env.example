TURSO_DATABASE_URL=libsql://your-database-host.turso.io
TURSO_AUTH_TOKEN=your-turso-database-auth-token

# Groq (AI chat, analytics, sentiment). Create at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: comma-separated fallback keys
# GROQ_API_KEYS=gsk_second,gsk_third

# Local Ollama (OpenAI-compatible API). Backup when Groq fails if user selects Groq Cloud.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b
# Optional: max tokens for AI Analytics graph JSON (default 3072; Groq / cloud)
# OLLAMA_GRAPH_MAX_TOKENS=4096
# Optional: max tokens for local Ollama graph JSON (default 1400 — keeps output small and valid)
# OLLAMA_GRAPH_LOCAL_MAX_TOKENS=1600
